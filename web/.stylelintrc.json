{
  "extends": "stylelint-config-recommended",
  "rules": {
    "max-nesting-depth": [
      0,
      {
        "message": "Вложенные правила запрещены: скорее всего, пропущена закрывающая скобка"
      }
    ],
    "no-descending-specificity": null,
    "color-no-hex": [
      true,
      {
        "message": "Цвет — переменной из :root в index.css"
      }
    ],
    "color-named": [
      "never",
      {
        "message": "Цвет — переменной из :root в index.css"
      }
    ],
    "function-disallowed-list": [
      [
        "rgb",
        "rgba",
        "hsl",
        "hsla"
      ],
      {
        "message": "Цвет — переменной из :root в index.css"
      }
    ],
    "declaration-property-value-allowed-list": [
      {
        "font-size": [
          "/^var\\(--fs-/",
          "inherit",
          "/^[0-9.]+em$/"
        ],
        "font": [
          "inherit",
          "/var\\(--fs-/"
        ]
      },
      {
        "message": "Размер шрифта — из шкалы --fs-* в :root"
      }
    ]
  }
}
