{
    "schemes": [
        "https",
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Система управления задачами и временем с Telegram-ботом. Единый формат ошибок — ТЗ §9.3.",
        "title": "TaskFlow API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/ping": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Проверка связи",
                "responses": {
                    "200": {
                        "description": "pong: true",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Проверяет PostgreSQL и Redis. 200 — всё доступно, 503 — есть недоступный компонент.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Состояние сервиса",
                "responses": {
                    "200": {
                        "description": "status: ok",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "503": {
                        "description": "status: degraded",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "JWT access-токен: \"Bearer \u003ctoken\u003e\" (ТЗ §9.1)",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}