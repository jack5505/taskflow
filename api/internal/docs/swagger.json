{
    "schemes": [
        "https",
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Система управления задачами и временем с Telegram-ботом. Единый формат ошибок — ТЗ §9.3.",
        "title": "TaskFlow API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/auth/login": {
            "post": {
                "description": "Возвращает access-токен (15 минут) и ставит httpOnly cookie refresh_token (30 дней). После 10 неудачных попыток вход по email закрыт на 15 минут.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Вход",
                "parameters": [
                    {
                        "description": "email и пароль",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.loginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth.SessionResponse"
                        }
                    },
                    "400": {
                        "description": "VALIDATION_FAILED",
                        "schema": {
                            "$ref": "#/definitions/apierr.Response"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED: неверный email или пароль, пользователь деактивирован",
                        "schema": {
                            "$ref": "#/definitions/apierr.Response"
                        }
                    },
                    "429": {
                        "description": "RATE_LIMITED: вход заблокирован, details.retry_after_seconds",
                        "schema": {
                            "$ref": "#/definitions/apierr.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "description": "Отзывает refresh-токен из cookie и очищает её. Требует X-Requested-With: XMLHttpRequest.",
                "tags": [
                    "auth"
                ],
                "summary": "Выйти",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Защита от CSRF: любое значение, например XMLHttpRequest",
                        "name": "X-Requested-With",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "403": {
                        "description": "FORBIDDEN: нет заголовка X-Requested-With",
                        "schema": {
                            "$ref": "#/definitions/apierr.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/logout-all": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Выйти везде",
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/apierr.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/password-reset": {
            "post": {
                "description": "Отправляет на email ссылку для установки нового пароля (действует 24 часа, одноразовая). Ответ всегда 204, даже если такого пользователя нет; повторный запрос на тот же email в течение минуты письма не шлёт.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Восстановить пароль",
                "parameters": [
                    {
                        "description": "email",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.passwordResetRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "VALIDATION_FAILED",
                        "schema": {
                            "$ref": "#/definitions/apierr.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/password-set": {
            "post": {
                "description": "Токен из ссылки одноразовый: после успешной установки повторно не принимается. Все сессии пользователя отзываются.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Задать пароль по ссылке",
                "parameters": [
                    {
                        "description": "токен из ссылки и новый пароль (не короче 10 символов)",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.passwordSetRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "VALIDATION_FAILED: пароль короче 10 символов; details.fields[token] — ссылка недействительна, использована или истекла",
                        "schema": {
                            "$ref": "#/definitions/apierr.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/refresh": {
            "post": {
                "description": "Требует cookie refresh_token и заголовок X-Requested-With: XMLHttpRequest (защита от CSRF). Старый refresh-токен отзывается.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Обновить access-токен",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Защита от CSRF: любое значение, например XMLHttpRequest",
                        "name": "X-Requested-With",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth.SessionResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED: сессия истекла или отозвана",
                        "schema": {
                            "$ref": "#/definitions/apierr.Response"
                        }
                    },
                    "403": {
                        "description": "FORBIDDEN: нет заголовка X-Requested-With",
                        "schema": {
                            "$ref": "#/definitions/apierr.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/ping": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Проверка связи",
                "responses": {
                    "200": {
                        "description": "pong: true",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Проверяет PostgreSQL и Redis. 200 — всё доступно, 503 — есть недоступный компонент.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Состояние сервиса",
                "responses": {
                    "200": {
                        "description": "status: ok",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "503": {
                        "description": "status: degraded",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "apierr.Body": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "INVALID_TRANSITION"
                },
                "details": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "message": {
                    "type": "string",
                    "example": "Переход done → todo не разрешён"
                }
            }
        },
        "apierr.Response": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/apierr.Body"
                }
            }
        },
        "auth.SessionResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "type": "integer",
                    "example": 900
                },
                "token_type": {
                    "type": "string",
                    "example": "Bearer"
                },
                "user": {
                    "$ref": "#/definitions/user.User"
                }
            }
        },
        "auth.loginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 254
                },
                "password": {
                    "type": "string",
                    "maxLength": 200
                }
            }
        },
        "auth.passwordResetRequest": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 254
                }
            }
        },
        "auth.passwordSetRequest": {
            "type": "object",
            "required": [
                "password",
                "token"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 10
                },
                "token": {
                    "type": "string",
                    "maxLength": 200
                }
            }
        },
        "user.User": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "display_name": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "is_system_admin": {
                    "type": "boolean"
                },
                "notification_settings": {
                    "type": "object"
                },
                "telegram_user_id": {
                    "type": "integer"
                },
                "telegram_username": {
                    "type": "string"
                },
                "timezone": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "JWT access-токен: \"Bearer \u003ctoken\u003e\" (ТЗ §9.1)",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}