# Копируйте в .env и заполните. Секреты только здесь, не в коде (ТЗ §10.3).

# HTTP
APP_ADDR=:8080
APP_BASE_URL=https://tasks.157.173.109.181.nip.io
APP_ENV=development

# PostgreSQL
DATABASE_URL=postgres://taskflow:taskflow@postgres:5432/taskflow?sslmode=disable

# Redis (очередь asynq, лимиты, идемпотентность update_id)
REDIS_ADDR=redis:6379

# JWT
# Не короче 32 символов: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Telegram-бот (ТЗ §8.8). Пустой токен — бот выключен, webhook не регистрируется.
TELEGRAM_BOT_TOKEN=
# Секрет заголовка X-Telegram-Bot-Api-Secret-Token: 1–256 символов A-Z a-z 0-9 _ -,
# обязателен при заданном токене: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-me
# Имя бота без @ (для /cmd@бот в группах и ссылки t.me), обязательно при заданном токене
TELEGRAM_BOT_USERNAME=
# Адрес Bot API; пусто — https://api.telegram.org (другой — локальный Bot API или тестовый сервер)
TELEGRAM_API_URL=
# true — long polling вместо webhook, только для локальной разработки (в production запрещено)
TELEGRAM_POLLING=

# SMTP (ТЗ §10.2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TaskFlow <noreply@example.com>

# Вложения (ТЗ §3.9)
ATTACHMENTS_DIR=/data/attachments
# Лимит размера вложения в байтах (§3.9: 50 МБ). nginx: client_max_body_size чуть больше.
ATTACHMENT_MAX_BYTES=52428800

# Выкладка и бэкап (deploy/README.md)
# TASKFLOW_IMAGE пишет deploy/deploy.sh; локально не задавать — соберётся taskflow:local
# COMPOSE_PROJECT_NAME и TASKFLOW_PORT меняют только для копии стенда (проверка восстановления)
COMPOSE_PROJECT_NAME=taskflow
TASKFLOW_PORT=8100
BACKUP_DIR=
BACKUP_KEEP_DAYS=30
# rclone remote для внешней копии бэкапов, например s3:backups/taskflow; конфиг — deploy/rclone.conf
BACKUP_REMOTE=
